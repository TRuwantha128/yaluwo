# Copy this file to .env.local and paste your Google Maps key.
# Get a key: https://console.cloud.google.com/google/maps-apis
# Enable: "Maps JavaScript API" and "Places API (New)"
# Restrict the key to: http://localhost:*  (and your real domain later)
VITE_GOOGLE_MAPS_API_KEY=

# Only when the website is hosted: the API's address (no trailing slash).
# Leave empty for local development.
# VITE_API_URL=https://api.tharinduruwantha.dev
